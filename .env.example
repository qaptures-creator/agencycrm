# Postgres connection string. Locally: run a Postgres instance and point this
# at it, e.g. `postgresql://postgres:postgres@localhost:5432/agencycrm`.
# In production (Railway, Neon, Supabase, RDS, etc.) this is provided by the
# platform — just wire it into this env var.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agencycrm"

# Optional — Microsoft 365 integration (Outlook inbox on the dashboard,
# OneDrive document uploads on client profiles). Create an app registration
# in Azure Portal > Microsoft Entra ID > App registrations, with a Web
# redirect URI of "<APP_URL>/api/auth/microsoft/callback" and delegated
# Graph permissions Mail.Read, Files.ReadWrite, Calendars.Read,
# offline_access, User.Read.
# Leave these unset to run without the integration — it degrades gracefully.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Required if using the Microsoft integration above. Your app's real public
# URL, no trailing slash — e.g. https://prmote-production.up.railway.app
# Must exactly match the redirect URI registered in Azure. Deliberately not
# inferred from the request: behind Railway's proxy that can resolve to an
# internal address (localhost:8080) instead of the public domain, which
# Azure then rejects with AADSTS50011.
APP_URL=

# PRMOTE MCP integration (lets ChatGPT read/write CRM data through
# /api/mcp — see MCP_SETUP.md). OAuth via WorkOS AuthKit is the real,
# ChatGPT-compatible path; requires APP_URL (above) to also be set, since
# the resource/audience is derived as "<APP_URL>/api/mcp". Also used to
# build the /.well-known/oauth-protected-resource metadata document.
# No WORKOS_API_KEY or WORKOS_CLIENT_ID needed — verification is fully
# offline against WorkOS's public JWKS.
MCP_OAUTH_ISSUER=
# Optional — defaults to "<MCP_OAUTH_ISSUER>/oauth2/jwks" if unset.
MCP_OAUTH_JWKS_URL=

# Legacy fallback credential for /api/mcp, kept temporarily alongside OAuth
# above while the ChatGPT connection is being proven out end-to-end — see
# MCP_SETUP.md for the removal plan. A long random shared secret, e.g.
# `openssl rand -hex 32`. If BOTH this and MCP_OAUTH_ISSUER are unset,
# /api/mcp returns 503 without exposing any data.
PRMOTE_MCP_API_KEY=

# Business Finder (local business prospecting -> lead) — a server-side-only
# Google Maps Platform key, never sent to the browser. Enable "Places API
# (New)" and "Geocoding API" in Google Cloud Console for this key, and
# restrict it to those two APIs (an IP/application restriction isn't
# possible since Railway's outbound IP isn't fixed — API restriction is
# what actually protects it). Leave unset to run without Business Finder —
# it shows a clear "not configured" message instead of erroring.
GOOGLE_MAPS_API_KEY=
