# Postgres connection string. Locally: run a Postgres instance and point this
# at it, e.g. `postgresql://postgres:postgres@localhost:5432/agencycrm`.
# In production (Railway, Neon, Supabase, RDS, etc.) this is provided by the
# platform — just wire it into this env var.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agencycrm"

# --- Muscle Massacre Gym CRM (optional) ---------------------------------
# Bootstrap Owner account created by `npm run db:seed` the first time it
# runs (only if no GymUser exists yet). Set these for a real deploy so the
# printed default password isn't the one in use; omit locally and a random
# one will be generated and printed to the console.
# GYM_OWNER_EMAIL="owner@musclemassacre.com"
# GYM_OWNER_NAME="Gym Owner"
# GYM_OWNER_PASSWORD="choose-a-strong-password"

# Set to "true" to also seed realistic development-only demo data (staff,
# members, tasks, etc). Never set this in a real production environment.
# SEED_GYM_DEMO="true"

# --- Goodtill / SumUp POS (optional) — powers the Shake Bar tab ---------
# Read-only server-side integration (src/lib/gym/integrations/goodtill-client.ts).
# Credentials for a store_owner or admin user (not "operator" — the API
# rejects those). See https://apidoc.thegoodtill.com for the official docs.
# GOODTILL_API_URL="https://api.thegoodtill.com/api"
# GOODTILL_SUBDOMAIN="musclemassacre"
# GOODTILL_USERNAME="choose-an-api-user"
# GOODTILL_PASSWORD="choose-a-strong-password"

# Webhook receiver at /api/gym/webhooks/goodtill (sale.completed, near-real-
# time sales sync). Configure the webhook URL + events in the Goodtill
# backoffice at https://pos.thegoodtill.com/app/integrations/webhook, then
# copy the "Verification Token" shown there into this var — it's how the
# webhook route authenticates inbound requests (see
# https://support.thegoodtill.com/support/webhook).
# GOODTILL_WEBHOOK_VERIFICATION_TOKEN="paste-the-backoffice-verification-token"

# --- Member Map (optional) — powers the Map view on /gym/members --------
# Server-side postcode geocoding (src/lib/gym/geocoding/mapbox-provider.ts).
# Never sent to the browser.
# MAPBOX_ACCESS_TOKEN="pk.your-mapbox-token"
#
# Public token used by the Mapbox GL map that renders in the browser — this
# is Mapbox's own intended client-side usage (restrict it to your domain in
# the Mapbox dashboard for extra safety). Can be the same value as
# MAPBOX_ACCESS_TOKEN above, or a separate token if you'd rather keep them
# scoped apart.
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-token"
