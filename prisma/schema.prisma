// Agency CRM — Prisma schema
// Status/type fields are Strings (not native enums) because several of them
// (pipeline stages, deliverable statuses) are user-customizable at runtime —
// backed by shared TypeScript union types + zod validators where they aren't
// (see src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Team
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("MEMBER") // ADMIN | MEMBER
  color     String   @default("#6366f1") // avatar accent color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads        Lead[]        @relation("LeadAssignee")
  activities           Activity[]    @relation("ActivityCreatedBy")
  videographerProjects Project[]     @relation("ProjectVideographer")
  photographerProjects Project[]     @relation("ProjectPhotographer")
  editorProjects       Project[]     @relation("ProjectEditor")
  editorDeliverables   Deliverable[] @relation("DeliverableEditor")
}

// ---------------------------------------------------------------------------
// Shared catalogs
// ---------------------------------------------------------------------------

model Service {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  leads   Lead[]   @relation("LeadServices")
  clients Client[] @relation("ClientServices")
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String   @default("#6366f1")
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model DeliverableStatusOption {
  id         String   @id @default(cuid())
  name       String
  order      Int
  color      String   @default("#6366f1")
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  deliverables Deliverable[]
}

// ---------------------------------------------------------------------------
// CRM: Leads & Pipeline
// ---------------------------------------------------------------------------

model Lead {
  id              String    @id @default(cuid())
  companyName     String
  contactName     String
  email           String?
  phone           String?
  instagram       String?
  website         String?
  industry        String?
  location        String?
  source          String?
  estimatedValue  Float?
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stage   PipelineStage @relation(fields: [stageId], references: [id])
  stageId String

  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  services Service[] @relation("LeadServices")

  activities Activity[]

  client Client?

  @@index([stageId])
  @@index([assignedToId])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id              String    @id @default(cuid())
  companyName     String
  mainContactName String
  email           String?
  phone           String?
  instagram       String?
  website         String?
  monthlyRetainer Float?
  contractStart   DateTime?
  contractEnd     DateTime?
  paymentStatus   String    @default("CURRENT") // CURRENT | OVERDUE | PAUSED
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | CHURNED
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fromLead   Lead?   @relation(fields: [fromLeadId], references: [id])
  fromLeadId String? @unique

  services Service[] @relation("ClientServices")

  projects     Project[]
  deliverables Deliverable[]
  invoices     Invoice[]
  activities   Activity[]
  retainer     Retainer?
}

// ---------------------------------------------------------------------------
// Projects & Shoots
// ---------------------------------------------------------------------------

model Project {
  id            String    @id @default(cuid())
  name          String
  shootDate     DateTime?
  shootTime     String?
  shootLocation String?
  projectType   String?
  status        String    @default("PLANNING")
  deadline      DateTime?
  internalNotes String?
  clientNotes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  videographer   User?   @relation("ProjectVideographer", fields: [videographerId], references: [id])
  videographerId String?

  photographer   User?   @relation("ProjectPhotographer", fields: [photographerId], references: [id])
  photographerId String?

  editor   User?   @relation("ProjectEditor", fields: [editorId], references: [id])
  editorId String?

  deliverables Deliverable[]

  @@index([clientId])
  @@index([shootDate])
}

// ---------------------------------------------------------------------------
// Deliverables
// ---------------------------------------------------------------------------

model Deliverable {
  id             String    @id @default(cuid())
  contentType    String // REEL | TIKTOK | YOUTUBE_VIDEO | PHOTOGRAPHY | AD_CREATIVE | SOCIAL_POST | OTHER
  customTypeName String?
  deadline       DateTime?
  revisionCount  Int       @default(0)
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED | REVISIONS_REQUESTED
  deliveryLink   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  assignedEditor   User?   @relation("DeliverableEditor", fields: [assignedEditorId], references: [id])
  assignedEditorId String?

  status   DeliverableStatusOption @relation(fields: [statusId], references: [id])
  statusId String

  @@index([clientId])
  @@index([projectId])
  @@index([statusId])
}

// ---------------------------------------------------------------------------
// Retainers
// ---------------------------------------------------------------------------

model Retainer {
  id                   String    @id @default(cuid())
  monthlyRetainer      Float
  shootsIncluded       Int       @default(0)
  videosIncluded       Int       @default(0)
  photosIncluded       Int       @default(0)
  shootsUsed           Int       @default(0)
  videosUsed           Int       @default(0)
  photosUsed           Int       @default(0)
  nextShootDate        DateTime?
  nextPaymentDate      DateTime?
  renewalDate          DateTime?
  servicesIncludedText String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(cuid())
  amount      Float
  type        String    @default("ONE_OFF") // RETAINER | ONE_OFF | PROJECT
  status      String    @default("DRAFT") // DRAFT | SENT | DUE | PAID | OVERDUE
  issueDate   DateTime?
  dueDate     DateTime?
  paidDate    DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Activities & Follow-ups
// ---------------------------------------------------------------------------

model Activity {
  id          String    @id @default(cuid())
  type        String // CALL | EMAIL | INSTAGRAM_DM | WHATSAPP | MEETING | PROPOSAL | FOLLOW_UP | NOTE
  subject     String?
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String?

  createdBy   User?   @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  createdById String?

  @@index([leadId])
  @@index([clientId])
  @@index([dueAt])
}

// =============================================================================
// MUSCLE MASSACRE — GYM CRM
// Separate product living in the same app/database as the Agency CRM above.
// Every model is prefixed `Gym` to keep the two domains from colliding.
// String "enum" fields follow the same convention as the Agency CRM: plain
// strings backed by shared TS unions in src/lib/gym/constants.ts.
// =============================================================================

// ---------------------------------------------------------------------------
// Auth, staff & permissions
// ---------------------------------------------------------------------------

model GymUser {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  accessRole        String    @default("STAFF") // OWNER | MANAGER | STAFF | MARKETING
  active            Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staff GymStaff?

  sessions               GymSession[]
  notifications          GymNotification[]
  createdAnnouncements   GymAnnouncement[]         @relation("AnnouncementCreatedBy")
  taskComments           GymTaskComment[]          @relation("TaskCommentAuthor")
  tasksCreated           GymTask[]                 @relation("TaskCreatedBy")
  enquiryMessages        GymEnquiryMessage[]       @relation("EnquiryMessageAuthor")
  memberNotes            GymMemberNote[]           @relation("MemberNoteAuthor")
  leadActivities         GymLeadActivity[]         @relation("LeadActivityCreatedBy")
  membershipEvents       GymMembershipEvent[]      @relation("MembershipEventCreatedBy")
  incidentsReported      GymIncident[]             @relation("IncidentReportedBy")
  auditLogs              GymAuditLog[]
  inventoryTxns          GymInventoryTransaction[] @relation("InventoryTxnCreatedBy")
  attachmentsUploaded    GymAttachment[]           @relation("AttachmentUploadedBy")
  resetTokens            GymPasswordResetToken[]
  cleaningTasksCreated   GymCleaningTask[]         @relation("CleaningTaskCreatedBy")
  cleaningTasksCompleted GymCleaningTask[]         @relation("CleaningTaskCompletedBy")
  navBadgesSeen          GymNavBadgeSeen[]

  @@index([accessRole])
}

/** Per-user "I've looked at this section" marker for the sidebar nav
 * badges — visiting a section clears its badge until something new
 * happens there. One row per (user, section). */
model GymNavBadgeSeen {
  id     String   @id @default(cuid())
  section String  // "/gym/members" | "/gym/shake-bar" | "/gym/enquiries"
  seenAt DateTime @default(now())

  user   GymUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, section])
}

model GymSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   GymUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model GymPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user   GymUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model GymStaff {
  id                    String    @id @default(cuid())
  fullName              String
  email                 String?
  phone                 String?
  position              String // Owner | Manager | Reception | Gym Floor Staff | Cleaner | Shake Bar | Marketing | Coach / PT
  employmentStatus      String    @default("Active") // Active | Part-Time | Casual | Former
  startDate             DateTime?
  endDate               DateTime?
  typicalHours          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl              String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   GymUser? @relation(fields: [userId], references: [id])
  userId String?  @unique

  shifts                GymRotaShift[]
  attendance            GymAttendance[]
  tasksAssigned         GymTask[]              @relation("TaskAssignee")
  enquiriesAssigned     GymEnquiry[]           @relation("EnquiryAssignee")
  leadsAssigned         GymLead[]              @relation("LeadAssignee")
  maintenanceReported   GymMaintenanceTicket[] @relation("MaintenanceReportedBy")
  maintenanceAssigned   GymMaintenanceTicket[] @relation("MaintenanceAssignee")
  contentOwned          GymMarketingContent[]  @relation("ContentOwner")
  cleaningTasksAssigned GymCleaningTask[]      @relation("CleaningTaskAssignee")

  @@index([position])
}

// ---------------------------------------------------------------------------
// Staff Rota & Attendance
// ---------------------------------------------------------------------------

model GymRotaShift {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  startTime    DateTime
  endTime      DateTime
  breakMinutes Int      @default(0)
  shiftRole    String?
  notes        String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff   GymStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId String

  attendance GymAttendance[]

  @@index([staffId])
  @@index([date])
}

model GymAttendance {
  id         String    @id @default(cuid())
  clockInAt  DateTime?
  clockOutAt DateTime?
  createdAt  DateTime  @default(now())

  staff   GymStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId String

  shift   GymRotaShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId String?

  @@index([staffId])
  @@index([shiftId])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model GymTask {
  id            String    @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  dueTime       String?
  priority      String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  category      String    @default("OTHER") // CLEANING | CUSTOMER_SERVICE | MEMBERSHIP | EQUIPMENT | MAINTENANCE | SHAKE_BAR | MARKETING | ADMIN | HEALTH_SAFETY | OTHER
  recurrence    String    @default("ONE_OFF") // ONE_OFF | DAILY | WEEKLY
  recurrenceDay String? // MON..SUN, for WEEKLY
  status        String    @default("TODO") // TODO | IN_PROGRESS | COMPLETED | OVERDUE
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedTo   GymStaff? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   GymUser? @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String?

  comments GymTaskComment[]

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model GymTaskComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  task   GymTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  author   GymUser? @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  authorId String?

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Members & Memberships
// ---------------------------------------------------------------------------

model GymMember {
  id                    String    @id @default(cuid())
  memberNumber          String    @unique
  fullName              String
  email                 String?
  phone                 String?
  dob                   DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  joinDate              DateTime  @default(now())
  lastVisitAt           DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // --- Member Map geocoding (privacy note: latitude/longitude are the
  // postcode centroid plus a small deterministic per-member jitter — never
  // an exact residential coordinate) ---
  postcode      String? // normalized UK postcode extracted from `address`, e.g. "SL6 7AB"
  placeName     String? // town/locality from the geocoder, e.g. "Maidenhead"
  latitude      Float?
  longitude     Float?
  distanceMiles Float? // cached great-circle distance from the gym's location
  geocodeStatus String? // OK | FAILED | NO_POSTCODE — null means never attempted
  geocodedAt    DateTime?

  // --- Ashbourne BI sync (see src/lib/ashbourne/) ---
  // memberNumber above is already the Ashbourne Member No for anyone
  // created via the CSV import (src/lib/gym/ashbourne-sales-import.ts uses
  // InternalID directly) — ashbourneMemberNo is the authoritative link
  // going forward, but sync matching also checks memberNumber first so it
  // never creates a duplicate for those existing records.
  ashbourneMemberNo       String?   @unique
  ashbourneLastSyncedAt   DateTime?
  ashbourneStatus         String? // raw status string from the Ashbourne report
  ashbourneMembershipType String?
  ashbourneExpiryDate     DateTime?
  // Set when an incoming Ashbourne record matched more than one existing
  // CRM member by email (or another non-definitive signal) — sync refuses
  // to guess, and this member needs a human to confirm/link it manually.
  reviewRequired          Boolean   @default(false)
  reviewRequiredReason    String?

  memberships     GymMembership[]
  memberNotes     GymMemberNote[]
  payments        GymPayment[]
  leadsWon        GymLead[]         @relation("LeadConvertedMember")
  enquiries       GymEnquiry[]      @relation("EnquiryConvertedMember")
  emails          GymEmailMessage[]
  liveEntryEvents GymLiveEntryEvent[]

  @@index([email])
  @@index([phone])
  @@index([geocodeStatus])
  @@index([placeName])
}

model GymMemberNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  member   GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  author   GymUser? @relation("MemberNoteAuthor", fields: [authorId], references: [id])
  authorId String?

  @@index([memberId])
}

model GymMembershipPlan {
  id                   String   @id @default(cuid())
  name                 String
  price                Float
  billingFrequency     String   @default("MONTHLY") // WEEKLY | MONTHLY | ANNUAL
  joiningFee           Float?
  contractLengthMonths Int?
  active               Boolean  @default(true)
  description          String?
  source               String   @default("MANUAL") // MANUAL | ASHBOURNE
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships GymMembership[]
}

model GymMembership {
  id               String    @id @default(cuid())
  startDate        DateTime  @default(now())
  renewalDate      DateTime?
  status           String    @default("ACTIVE") // ACTIVE | FROZEN | CANCELLED | EXPIRED | OVERDUE
  billingAmount    Float
  paymentFrequency String    @default("MONTHLY")
  paymentStatus    String    @default("CURRENT") // CURRENT | OVERDUE | FAILED
  freezeStart      DateTime?
  freezeEnd        DateTime?
  cancelledAt      DateTime?
  source           String    @default("MANUAL") // MANUAL | ASHBOURNE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  member   GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  plan   GymMembershipPlan @relation(fields: [planId], references: [id])
  planId String

  events GymMembershipEvent[]

  @@index([memberId])
  @@index([planId])
  @@index([status])
}

model GymMembershipEvent {
  id        String   @id @default(cuid())
  type      String // JOINED | FROZEN | UNFROZEN | CANCELLED | RENEWED | PAYMENT_FAILED | UPDATED
  notes     String?
  createdAt DateTime @default(now())

  membership   GymMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipId String

  createdBy   GymUser? @relation("MembershipEventCreatedBy", fields: [createdById], references: [id])
  createdById String?

  @@index([membershipId])
}

model GymPayment {
  id             String   @id @default(cuid())
  transactionRef String?
  date           DateTime @default(now())
  amount         Float
  type           String   @default("MEMBERSHIP") // MEMBERSHIP | JOINING_FEE | DAY_PASS | OTHER
  status         String   @default("PAID") // PAID | PENDING | FAILED | REFUNDED
  provider       String   @default("ASHBOURNE")
  createdAt      DateTime @default(now())

  member   GymMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId String?

  @@index([memberId])
  @@index([status])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Enquiries (email inbox architecture)
// ---------------------------------------------------------------------------

model GymEnquiry {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  subject    String?
  category   String    @default("OTHER") // MEMBERSHIP | DAY_PASS | GENERAL | CANCELLATION | PAYMENT | COMPLAINT | PERSONAL_TRAINING | FACILITIES | BUSINESS | OTHER
  status     String    @default("NEW") // NEW | REPLIED | AWAITING_RESPONSE | FOLLOW_UP | CONVERTED | CLOSED
  priority   String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  source     String    @default("MANUAL") // EMAIL | WEBSITE | PHONE | WALK_IN | MANUAL
  followUpAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignedTo   GymStaff? @relation("EnquiryAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  convertedToLead   GymLead?   @relation("LeadFromEnquiry")
  convertedMember   GymMember? @relation("EnquiryConvertedMember", fields: [convertedMemberId], references: [id])
  convertedMemberId String?

  messages GymEnquiryMessage[]

  @@index([status])
  @@index([assignedToId])
  @@index([category])
}

model GymEnquiryMessage {
  id        String   @id @default(cuid())
  direction String // INBOUND | OUTBOUND | INTERNAL_NOTE
  body      String
  fromEmail String?
  createdAt DateTime @default(now())

  enquiry   GymEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryId String

  author   GymUser? @relation("EnquiryMessageAuthor", fields: [authorId], references: [id])
  authorId String?

  @@index([enquiryId])
}

// ---------------------------------------------------------------------------
// Lead CRM (membership sales pipeline)
// ---------------------------------------------------------------------------

model GymLead {
  id                 String    @id @default(cuid())
  name               String
  email              String?
  phone              String?
  source             String    @default("OTHER") // WEBSITE | INSTAGRAM | FACEBOOK | GOOGLE | WALK_IN | PHONE | EMAIL | REFERRAL | TIKTOK | OTHER
  membershipInterest String?
  stage              String    @default("NEW_LEAD") // NEW_LEAD | CONTACTED | INTERESTED | TOUR_BOOKED | TRIAL | FOLLOW_UP | READY_TO_JOIN | JOINED | LOST
  lastContactAt      DateTime?
  nextFollowUpAt     DateTime?
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedTo   GymStaff? @relation("LeadAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  campaign   GymMarketingCampaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  fromEnquiry   GymEnquiry? @relation("LeadFromEnquiry", fields: [fromEnquiryId], references: [id])
  fromEnquiryId String?     @unique

  convertedMember   GymMember? @relation("LeadConvertedMember", fields: [convertedMemberId], references: [id])
  convertedMemberId String?

  activities GymLeadActivity[]

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
}

model GymLeadActivity {
  id        String   @id @default(cuid())
  type      String // CALL | EMAIL | NOTE | TOUR | FOLLOW_UP | STAGE_CHANGE
  notes     String?
  createdAt DateTime @default(now())

  lead   GymLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  createdBy   GymUser? @relation("LeadActivityCreatedBy", fields: [createdById], references: [id])
  createdById String?

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Equipment & Maintenance
// ---------------------------------------------------------------------------

model GymEquipment {
  id              String    @id @default(cuid())
  name            String
  manufacturer    String?
  model           String?
  category        String    @default("OTHER") // CHEST | BACK | SHOULDERS | ARMS | LEGS | CARDIO | FREE_WEIGHTS | OTHER
  serialNumber    String?
  purchaseDate    DateTime?
  condition       String    @default("GOOD") // EXCELLENT | GOOD | NEEDS_ATTENTION | OUT_OF_SERVICE
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  location        String?
  notes           String?
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  maintenanceTickets GymMaintenanceTicket[]

  @@index([category])
  @@index([condition])
}

// ---------------------------------------------------------------------------
// Equipment Cleaning
// ---------------------------------------------------------------------------

// Configurable catalog of cleaning zones/areas (Free Weights, Cardio, etc.) —
// managed from the Cleaning page, not hardcoded, so gyms can rename/add/retire
// zones without a code change. Mirrors the Agency CRM's PipelineStage pattern.
model GymCleaningZone {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tasks GymCleaningTask[]

  @@index([order])
}

model GymCleaningTask {
  id               String    @id @default(cuid())
  date             DateTime  @db.Date
  whatBeingCleaned String
  status           String    @default("PENDING") // PENDING | IN_PROGRESS | AWAITING_REVIEW | COMPLETE | MISSED
  notes            String?
  photoUrl         String? // optional — staff currently send proof over WhatsApp; manager can attach it here later
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  zone   GymCleaningZone @relation(fields: [zoneId], references: [id])
  zoneId String

  assignedTo   GymStaff? @relation("CleaningTaskAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   GymUser? @relation("CleaningTaskCreatedBy", fields: [createdById], references: [id])
  createdById String?

  completedBy   GymUser? @relation("CleaningTaskCompletedBy", fields: [completedById], references: [id])
  completedById String?

  @@index([date])
  @@index([zoneId])
  @@index([status])
}

model GymMaintenanceTicket {
  id              String    @id @default(cuid())
  issue           String
  area            String?
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  reportedAt      DateTime  @default(now())
  photoUrl        String?
  status          String    @default("REPORTED") // REPORTED | INVESTIGATING | SCHEDULED | IN_PROGRESS | FIXED
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  equipment   GymEquipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentId String?

  reportedBy   GymStaff? @relation("MaintenanceReportedBy", fields: [reportedById], references: [id])
  reportedById String?

  assignedTo   GymStaff? @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  @@index([equipmentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Incidents
// ---------------------------------------------------------------------------

model GymIncident {
  id               String   @id @default(cuid())
  occurredAt       DateTime @default(now())
  category         String   @default("OTHER") // INJURY | ACCIDENT | CUSTOMER_DISPUTE | SECURITY | EQUIPMENT_FAILURE | OTHER
  location         String?
  description      String
  actionTaken      String?
  witnesses        String?
  followUpRequired Boolean  @default(false)
  followUpNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reportedBy   GymUser? @relation("IncidentReportedBy", fields: [reportedById], references: [id])
