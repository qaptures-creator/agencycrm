// ---------------------------------------------------------------------------
// Shake Bar
// ---------------------------------------------------------------------------

model GymShakeBarProduct {
  id              String    @id @default(cuid())
  name            String
  category        String    @default("OTHER") // PROTEIN | PRE_WORKOUT | HYDRATION | ENERGY_DRINKS | SNACKS | OTHER
  stock           Int       @default(0)
  costPrice       Float?
  sellingPrice    Float?
  lowStockLevel   Int       @default(5)
  supplier        String?
  lastRestockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions GymInventoryTransaction[]

  @@index([category])
}

model GymInventoryTransaction {
  id        String   @id @default(cuid())
  type      String // RESTOCK | SALE | ADJUSTMENT | WASTE
  quantity  Int
  note      String?
  createdAt DateTime @default(now())

  product   GymShakeBarProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdBy   GymUser? @relation("InventoryTxnCreatedBy", fields: [createdById], references: [id])
  createdById String?

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Goodtill / SumUp POS mirror — powers the Shake Bar tab's live sales view.
// Deliberately no hard FK relations across these (productExternalId,
// categoryExternalId, sale->items use plain indexed string columns, joined
// in application code) so a webhook or sync for a not-yet-seen product/sale
// never fails on referential integrity — catalog and sales sync run
// independently and must tolerate arriving out of order.
// ---------------------------------------------------------------------------

model GymPosCategory {
  id               String   @id @default(cuid())
  externalId       String   @unique // Goodtill category id
  name             String
  description      String?
  parentExternalId String?
  active           Boolean  @default(true)
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GymPosProduct {
  id                 String   @id @default(cuid())
  externalId         String   @unique // Goodtill product id
  name               String
  sku                String?
  categoryExternalId String?
  sellingPrice       Float?
  purchasePrice      Float?
  active             Boolean  @default(true)
  trackInventory     Boolean  @default(false)
  inventory          Float?
  minStock           Float?
  alertOn            Boolean  @default(false)
  alertBelow         Float?
  outletExternalId   String?
  raw                Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([categoryExternalId])
  @@index([sku])
}

model GymPosSale {
  id               String   @id @default(cuid())
  externalId       String   @unique // Goodtill sale id
  outletExternalId String?
  outletName       String?
  registerId       String?
  staffId          String?
  customerId       String?
  orderNo          Int?
  receiptNo        String?
  saleType         String? // INSTORE | TABLE | WEB | ...
  orderStatus      String? // COMPLETED | VOIDED | ...
  saleDateTime     DateTime
  totalIncVat      Float
  totalExVat       Float?
  totalVat         Float?
  discountAmount   Float?
  paymentMethods   String? // comma-joined keys of sales_payments, e.g. "CARD"
  refunded         Boolean  @default(false)
  source           String   @default("WEBHOOK") // WEBHOOK | HISTORICAL_SYNC
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items GymPosSaleItem[]

  @@index([saleDateTime])
  @@index([orderStatus])
}

model GymPosSaleItem {
  id                String  @id @default(cuid())
  externalId        String  @unique // Goodtill sales_items[].id
  productExternalId String?
  productName       String
  quantity          Float
  unitPriceIncVat   Float?
  lineTotalIncVat   Float?
  vatRate           Float?
  discountAmount    Float?
  isRemoved         Boolean @default(false)
  raw               Json?

  sale   GymPosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String

  @@index([saleId])
  @@index([productExternalId])
}

/**
 * Idempotency log for webhook deliveries — a message_id is inserted before
 * processing; a unique-constraint failure means "already handled", so the
 * handler can return 200 immediately without reprocessing.
 */
model GymPosWebhookEvent {
  id             String   @id @default(cuid())
  messageId      String   @unique
  event          String
  saleExternalId String?
  receivedAt     DateTime @default(now())
  status         String   @default("OK") // OK | ERROR
  error          String?
}

/**
 * Singleton-per-key status row surfaced in the Shake Bar UI ("last webhook
 * received", "last successful sync").
 */
model GymPosSyncState {
  id                          String    @id @default(cuid())
  key                         String    @unique @default("goodtill")
  lastWebhookAt               DateTime?
  lastWebhookEvent            String?
  lastCatalogSyncAt           DateTime?
  lastSalesSyncAt             DateTime?
  lastSalesSyncStatus         String? // OK | ERROR
  lastSalesSyncError          String?
  historicalImportStartedAt   DateTime?
  historicalImportCompletedAt DateTime?
  historicalImportSalesCount  Int?
  lastSalesSyncImportedCount  Int?
  updatedAt                   DateTime  @updatedAt
}

