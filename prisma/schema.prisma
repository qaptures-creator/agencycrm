  phone        String?
  email        String   @default("admin@musclemassacre.com")
  website      String   @default("https://musclemassacre.com")
  openingHours Json?
  latitude     Float? // geocoded from `address` — origin point for member distance calcs
  longitude    Float?
  updatedAt    DateTime @updatedAt
}

/**
 * Singleton progress/status row for the member geocoding backfill, shown
 * on the Member Map so staff can see it actually ran rather than silently
 * doing nothing.
 */
model GymGeocodeSyncState {
  id              String    @id @default("singleton")
  lastRunAt       DateTime?
  lastRunStatus   String? // OK | ERROR | RUNNING
  lastRunError    String?
  totalCandidates Int?
  geocodedCount   Int?
  failedCount     Int?
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Email Centre — the IMAP mailbox stays the source of truth for content;
// only lightweight metadata is persisted here for fast filtering/listing.
// Full bodies are fetched live from IMAP when a message is opened.
// ---------------------------------------------------------------------------

model GymEmailMessage {
  id         String @id @default(cuid())
  folderRole String // inbox | sent | drafts | spam | trash — the CRM's well-known role
  imapPath   String // the real IMAP mailbox path, e.g. "INBOX", "Sent"
  imapUid    Int

  messageId String? // RFC Message-ID header — used for threading/dedup
  inReplyTo String? // RFC In-Reply-To header

  fromAddress String?
  fromName    String?
  toAddresses Json? // [{ name, address }]
  ccAddresses Json?

  subject    String?
  receivedAt DateTime?

  isRead         Boolean @default(false)
  isFlagged      Boolean @default(false)
  hasAttachments Boolean @default(false)
  sizeBytes      Int?

  // Virtual CRM classification — set in a later phase, never moves the
  // message between real IMAP folders.
  classification String? // CANCELLATION | JOB_APPLICATION | MEMBERSHIP_ENQUIRY | COMPLAINT | GENERAL

  matchedMember   GymMember? @relation(fields: [matchedMemberId], references: [id], onDelete: SetNull)
  matchedMemberId String?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([imapPath, imapUid])
  @@index([folderRole])
  @@index([receivedAt])
  @@index([isRead])
  @@index([messageId])
  @@index([fromAddress])
  @@index([classification])
  @@index([matchedMemberId])
}

/**
 * Singleton — per-folder IMAP sync checkpoints (UIDVALIDITY/last UID seen/
 * how far back we've paged) so incremental sync never re-downloads or
 * duplicates messages.
 */
model GymEmailSyncState {
  id            String    @id @default("singleton")
  lastRunAt     DateTime?
  lastRunStatus String? // OK | ERROR | RUNNING
  lastRunError  String?
  folderState   Json? // { [role]: { uidValidity, lastUid, oldestSyncedSeq } }
  updatedAt     DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Ashbourne BI member sync (see src/lib/ashbourne/)
// ---------------------------------------------------------------------------

/**
 * One row per sync run (manual "Sync Now" or, later, scheduled) — the
 * audit trail for what Ashbourne actually returned and what the sync did
 * with it. Distinct from GymPosSyncState/GymEmailSyncState (which are
 * singleton checkpoints) because Phase 10's dry-run requirement means we
 * need to see the *history* of runs, not just the latest one.
 */
model GymAshbourneSyncLog {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  status         String    @default("RUNNING") // RUNNING | OK | ERROR
  dryRun         Boolean   @default(false)
  recordsFound   Int?
  created        Int?
  updated        Int?
  unchanged      Int?
  reviewRequired Int?
  skipped        Int?
  failed         Int?
  errorMessage   String?
  reportUrl      String? // which Ashbourne report this run used — configurable per Phase 11

  @@index([startedAt])
}

/**
 * Live gate-entry events from the Ashbourne biometric access log bridge
 * (C:\Ashbourne\MVSv4\Log on the gym Windows PC — see
 * src/app/api/gym/webhooks/live-entry/route.ts). Only the *result* of a
 * successful access event is stored — never a fingerprint template,
 * fingerprint image, or any other biometric payload; the Windows-side
 * watcher is responsible for discarding that before it ever reaches this
 * endpoint. Never touches GymMembership/GymMember status — this is a
 * read-only entry log, not a membership signal.
 */
model GymLiveEntryEvent {
  id         String   @id @default(cuid())
  memberNumber String // raw value from the bridge, kept even if unmatched
  entryTime  DateTime
  zone       String?
  device     String?
  allowed    Boolean  @default(true)
  source     String   @default("ASHBOURNE_LIVE_ENTRY")
  createdAt  DateTime @default(now())

  member   GymMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId String?

  // Dedup + idempotency key: the Windows bridge may resend the same log
  // line (retry after a network blip, log file re-read); the same
  // member/device/timestamp triple is treated as the same physical event.
  @@unique([memberNumber, device, entryTime])
  @@index([entryTime])
  @@index([memberId])
}
